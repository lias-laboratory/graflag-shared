# Copy to cluster.env (untracked) and fill in. Read by scaling.sh,
# reference/run_on_node.sh, janitor.sh, platform/pin_scan.sh, and through
# clusterenv.py by collect.py and repeatability.py.
MANAGER=MANAGER_IP                 # the swarm manager, which runs the registry
NODES="MANAGER_IP WORKER1_IP WORKER2_IP"
WORKERS="worker1-hostname worker2-hostname"   # as `docker node ls` names them
REGISTRY=MANAGER_IP:5000
CLUSTER_SUBNET=10.0.0.0/24         # kept off the proxy (no_proxy)
# The names results publish for each node, by its `docker node ls` hostname.
# collect.py and repeatability.py refuse to write a hostname missing here.
NODE_ALIASES="manager-hostname=node-1 worker1-hostname=node-2 worker2-hostname=node-3"
