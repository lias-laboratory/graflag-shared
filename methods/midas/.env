# MIDAS -- Microcluster-Based Detector of Anomalies in Edge Streams
# AAAI 2020. Unsupervised, streaming, constant time and memory per edge.

METHOD_NAME=midas
DESCRIPTION=MIDAS: microcluster-based anomaly detection in edge streams via count-min sketches, in constant time and memory (AAAI 2020)
SOURCE_CODE=https://github.com/Stream-AD/MIDAS
SOURCE_REF=8193235187bfd44ff4188721d4be5a913b231edc
INTEGRATION=upstream

# Edge streams as source,destination,timestamp with a per-edge label, which is
# exactly what these two datasets already are: anograph_darpa is byte-identical
# to the DARPA copy MIDAS itself ships (4,554,344 records, same labels).
SUPPORTED_DATASETS=anograph_darpa,anograph_iscx

COMMAND=python3 train_graflag.py

# Which core to run. Upstream selects this by editing commented lines in
# Demo.cpp; here it is a parameter, because the three are three published
# variants of the method and a benchmark wants all of them.
#   normal     -> MIDAS    (AAAI 2020)
#   relational -> MIDAS-R  (temporal and spatial relations)
#   filtering  -> MIDAS-F  (filters out anomalous edges before they corrupt
#                           the sketch; the paper's best variant)
_CORE=filtering

# Count-min sketch shape. Upstream's Demo uses 2 rows and 1024 columns.
_NUM_ROW=2
_NUM_COLUMN=1024
# Temporal decay applied at each tick. Upstream default: 0.5.
_FACTOR=0.5
# MIDAS-F only: score above which an edge is filtered out of the sketch.
# Ignored by the other two cores. Upstream's Demo uses 1e3.
_THRESHOLD=1000.0
# Upstream seeds with time(nullptr); GraFlag seeds deliberately so that a
# re-run of an experiment is the same experiment.
_SEED=42
