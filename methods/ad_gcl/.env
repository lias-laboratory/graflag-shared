# AD-GCL -- Revisiting Graph Contrastive Learning on Anomaly Detection
# from a Structural Imbalance Perspective. AAAI 2025. Unsupervised.

METHOD_NAME=ad_gcl
DESCRIPTION=AD-GCL: graph contrastive learning for node anomaly detection, corrected for the structural imbalance between high- and low-degree nodes (AAAI 2025)
SOURCE_CODE=https://github.com/yimingxu24/AD-GCL
SOURCE_REF=da110446c1a7a8d0b9d52c5f7f91ec104dc1dcf2
INTEGRATION=upstream

# The six .mat graphs AD-GCL ships and tunes for, registered as GraFlag
# datasets in their stored form -- these read the mounted file directly, with
# no conversion, because .mat is what upstream's load_mat() opens.
SUPPORTED_DATASETS=gad_cora,gad_citeseer,gad_pubmed,gad_bitcoinotc,gad_bitotc,gad_bitalpha

COMMAND=python3 train_graflag.py

# Upstream's README gives a per-dataset lr, num_epoch and threshold; the rest
# are argparse defaults. The README values for cora are the defaults here and
# train_graflag.py applies the right ones per dataset -- see README.md.
_EMBEDDING_DIM=64
_DROP_PROB=0.0
_WEIGHT_DECAY=0.0
_BATCH_SIZE=300
_SUBGRAPH_SIZE=4
_READOUT=avg
_NEGSAMP_RATIO=1
# Degree at which the high/low-degree split is drawn for the breakdown.
_DEGREE=6
# Rounds averaged to form the final score. Upstream default: 256. Lower it for
# a smoke run; it multiplies the scoring time directly.
_AUC_TEST_ROUNDS=256
# GPU index, -1 for CPU.
_GPU=0
_SEED=1
