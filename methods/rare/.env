METHOD_NAME=rare
DESCRIPTION=RARE: Rarity-based Anomaly Detection in Graphs via Order-Embedding Subgraph Mining (WISE 2026)
SOURCE_CODE=https://github.com/gbay7/rare-gad
# The commit the image is built from. The Dockerfile clones SOURCE_CODE and
# checks this out; graflag forwards both as --build-arg (BUILD_ARG_KEYS in
# docker_ops.py), so neither is repeated in the Dockerfile.
SOURCE_REF=79c9632402685d070eac78da6638ddf5e96499a8
# The image clones the authors' repository and runs its pipeline.
INTEGRATION=upstream

# The three PyGOD injected-outlier graphs upstream ships a benchmark
# configuration for, each run on the cluster; read from the share, nothing is
# downloaded. The runner refuses a dataset this list does not match.
SUPPORTED_DATASETS=bond_inj_cora,bond_inj_amazon,bond_inj_flickr

COMMAND=python3 train_graflag.py

# Upstream configuration, a file under configs/ in the clone (without .yaml).
# `auto` takes the one upstream's README lists as the benchmark run for the
# dataset: cora_order_glass_fast, amazon_order_glass_canon or
# flickr_order_glass_v2.
_CONFIG=auto

# Which injected anomalies are the ground truth. RARE detects structural
# anomalies, and every upstream benchmark configuration evaluates it against
# those alone (bit 1 of PyGOD's y);
# `all-anomaly` counts the contextual ones too, which is what the bond_*
# methods score against on the same datasets.
_TASK=struct-anomaly

_SEED=42

# GPU device index (-1 for CPU)
_GPU=0

# Deliberately not declared here: MAX_FREQ (the paper's T_F),
# OUTLIER_MAX_FREQ, MAX_STEPS, N_BEAMS and N_NEIGHBORHOODS. Each upstream
# configuration sets its own values, so a default here would override all
# three at once. Pass one with --params to depart from upstream's setting.
