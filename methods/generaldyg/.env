METHOD_NAME=generaldyg
DESCRIPTION=A Generalizable Anomaly Detection Method in Dynamic Graphs (AAAI 2025)
SOURCE_CODE=https://github.com/YXNTU/GeneralDyG
# The commit the image is built from. The Dockerfile clones SOURCE_CODE and
# checks this out; graflag forwards both as --build-arg (BUILD_ARG_KEYS in
# docker_ops.py), so neither is repeated in the Dockerfile. Bumping it is a
# deliberate edit, which is the point: an unpinned clone made a rebuild months
# later a different experiment wearing the same method name.
SOURCE_REF=86a014a41e6a78db70bcf7fa173a39a4090dea41
# Where the published numbers come from. `upstream` means the image fetches
# the authors' implementation and runs it.
INTEGRATION=upstream

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=generaldyg_*

COMMAND=python3 train_graflag.py

# General Parameters
# Positive class name. Default: EU3
_NAME_POS=EU3
# Negative sample ratio. Default: 1
_RATIO_NEG=1
# Negative data ratio selection: 01, 05, 1. Default: 01
_NEG=01
# Maximum sequence length (e.g., 24 for wikipedia). Default: 24
_MAX_LEN=24

# Data Parameters
# Batch size. Default: 128
_BATCH_SIZE=128
# Number of epochs. Default: 200
_N_EPOCHS=200
# Number of data workers. Default: 0
_NUM_DATA_WORKERS=0
# Number of GPUs upstream is told about. Default: 1
_GPUS=1
# GPU index this run uses; -1 means CPU, which is what --no-gpu sets.
# Read by graflag_runner.device(), not by upstream's parser.
_GPU=0

# Model Parameters
# Path to the checkpoint file. Default: ./
_CKPT_FILE=./src/
# Input dimension. Default: 128
_INPUT_DIM=128
# Hidden layer dimension. Default: 258
_HIDDEN_DIM=258
# Number of attention heads. Default: 4
_N_HEADS=4
# Dropout rate. Default: 0.4
_DROP_OUT=0.4
# Number of network layers. Default: 6
_N_LAYER=6
# Learning rate. Default: 0.0001
_LEARNING_RATE=0.0001
# Random seed. Default: 95540
_SEED=95540
