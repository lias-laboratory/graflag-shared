# ADA-GAD -- Anomaly-Denoised Autoencoders for Graph Anomaly Detection
# AAAI 2024. Unsupervised: no label is used for training or model selection.

METHOD_NAME=ada_gad
DESCRIPTION=Anomaly-Denoised Autoencoders: masked graph autoencoders pretrained on a denoised graph, then retrained for unsupervised node anomaly detection (AAAI 2024)
SOURCE_CODE=https://github.com/jweihe/ADA-GAD
SOURCE_REF=71a3aca936ccfe430e3809864f256d4bf80b22ee
INTEGRATION=upstream

# Exactly the seven datasets config_ada-gad.yml holds a tuned section for.
# Not one more: train_graflag.py raises when a dataset has no section, because
# the alternative is running on argparse defaults -- which crashes on the
# default activation (prelu), and if it did not, would publish a number from
# hyperparameters nobody chose. bond_gen_* was listed here and had to come
# off for exactly that reason.
SUPPORTED_DATASETS=bond_books,bond_disney,bond_enron,bond_reddit,bond_weibo,bond_inj_cora,bond_inj_amazon

COMMAND=python3 train_graflag.py

# Upstream's own defaults (config_ada-gad.yml is per dataset; these are the
# argparse fallbacks). Only the subset GraFlag overrides is listed -- the rest
# stay at whatever upstream's build_args() declares, via apply_params().
_MAX_EPOCH=100
_NUM_HIDDEN=128
_NUM_LAYERS=2
_LR=0.005
_WEIGHT_DECAY=0.0
_DROPOUT=0.2
# Number of independent runs upstream averages over. 1 keeps a GraFlag run
# to one seed; upstream's default is 5 and multiplies the runtime by five.
_SEEDS=1
# GPU index, -1 for CPU.
_GPU=0
_SEED=42
