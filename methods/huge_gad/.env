# HUGE-GAD -- A Label-Free Heterophily-Guided Approach for Unsupervised
# Graph Fraud Detection. AAAI 2025.

METHOD_NAME=huge_gad
DESCRIPTION=HUGE-GAD: label-free heterophily estimation guiding unsupervised graph fraud detection, with a ranking objective and MLP-GNN distillation (AAAI 2025)
SOURCE_CODE=https://github.com/CampanulaBells/HUGE-GAD
SOURCE_REF=bdf8d2aec6455b48d7322c0713e31d2f6fecc1b7
INTEGRATION=upstream

# The three .mat graphs it ships that GraFlag registers, plus the bond_*
# graphs it can read once rendered. train_graflag.py copies a .mat straight
# through and renders a .pt with graflag_runner.write_mat -- see README.md.
SUPPORTED_DATASETS=gad_amazon,gad_facebook,gad_yelpchi,bond_reddit,bond_weibo,bond_books,bond_disney,bond_enron

COMMAND=python3 train_graflag.py

# Upstream's argparse defaults, which are also the values its README publishes
# for Amazon, Facebook, Reddit and YelpChi -- unusually, the two agree, so
# there is no separate config table to carry.
_LR=5e-4
_EPOCH=300
_KD_PARAM=0.5
_WEIGHT_DECAY=0.0
_HIDDEN=128
_BATCH_SIZE_HETEROPHILY=8192
_BATCH_SIZE_SAMPLING=8192
# How neighbour heterophily is estimated: ours | cos | l2 | attr.
_HETEROPHILY=ours
# GPU index, -1 for CPU.
_GPU=0
_SEED=0
