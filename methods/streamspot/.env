METHOD_NAME=streamspot
DESCRIPTION=StreamSpot: Graph-Based Anomaly Detection in System Provenance Data
SOURCE_CODE=https://github.com/sbustreamspot/sbustreamspot-core
# The commit the image is built from. The Dockerfile clones SOURCE_CODE and
# checks this out; graflag forwards both as --build-arg (BUILD_ARG_KEYS in
# docker_ops.py), so neither is repeated in the Dockerfile. Bumping it is a
# deliberate edit, which is the point: an unpinned clone made a rebuild months
# later a different experiment wearing the same method name.
SOURCE_REF=6fb9eccf7d9d6c1f49e6f28e71e6a79ab9e31b11
# Where the published numbers come from. `upstream` means the image fetches
# the authors' implementation and runs it.
INTEGRATION=upstream

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=streamspot_*

COMMAND=python3 train_graflag.py

# StreamSpot Core Parameters
# Chunk length (shingle size). Default: 10
_CHUNK_LENGTH=10
# Number of parallel graphs to process. Default: 10
_NUM_PARALLEL_GRAPHS=10
# Maximum number of edges to process (-1 for all). Default: -1
_MAX_NUM_EDGES=-1
# Scenario subset: all, ydc (YouTube/Download/CNN), gfc (GMail/VGame/CNN).
# Anything else is rejected before the run starts. Default: all
_DATASET=all

# Accepted and recorded, but not read by this integration -- see README.md
# ("Parameters that do nothing"). Changing one warns and changes no result.
# Training ratio: the bootstrap clusters are the paper's pre-computed ones,
# so no split is drawn here.
_TRAINING_RATIO=0.5
# Random seed: nothing here draws a random number, and the binary takes none.
_SEED=42
# Global similarity threshold: the bootstrap file carries the paper's own
# (0.4823 for `all`), and that is the one the binary reads.
_GLOBAL_THRESHOLD=0.6
