METHOD_NAME=dynwalk
DESCRIPTION=NetWalk: A Flexible Deep Embedding Approach for Anomaly Detection in Dynamic Networks (KDD 2018)
SOURCE_CODE=https://github.com/chengw07/NetWalk
# Where the published numbers come from. `reimplementation` means nothing
# upstream is fetched: train_graflag.py implements the method from the paper,
# so the results are this code's and not the authors'. SOURCE_CODE above is a
# citation, not what ran -- README.md lists where the two differ.
INTEGRATION=reimplementation

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=*_snapshot

COMMAND=python3 train_graflag.py

# Embedding dimension
_REPRESENTATION_SIZE=32

# Random walk parameters
_WALK_LENGTH=5
_NUMBER_WALKS=20


# Initial graph percentage for training embeddings
_INIT_PERCENT=0.5

# Autoencoder training
_LEARNING_RATE=0.001
_EPOCHS=50
_HIDDEN_SIZE=64

# K-means clusters for anomaly detection
_N_CLUSTERS=5

# Random seed
_SEED=42

# GPU index; -1 means CPU, which is what --no-gpu sets. Read by
# graflag_runner.device(). This is -1 because the Dockerfile installs the
# CPU-only torch wheel, so cuda is never available inside the image and 0
# was a declaration the container could not honour -- see README.md
# ("This method runs on the CPU"). Run with --no-gpu so Swarm does not
# reserve a GPU nothing will use.
_GPU=-1
