# ==============================================================================
# GraFlag Method Configuration Template
# ==============================================================================
# This file defines method metadata and default parameters.
# Copy this template to create a new method: cp -r example your_method_name
#
# IMPORTANT: parameters starting with an underscore (_) are the method's own.
# train_graflag.py reads them with graflag_runner.params(), which strips the
# underscore, lowercases the name and coerces the value against your function's
# signature: _LEARNING_RATE=0.001 arrives as learning_rate=0.001, a float.
#
# (A method whose CMD passes --pass-env-args gets them as CLI arguments
# instead -- _LEARNING_RATE=0.001 becomes --learning_rate 0.001. Use that only
# when you are driving an upstream argparse script you would rather not edit.)
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Method Metadata
# ------------------------------------------------------------------------------

# Unique method identifier (must match directory name)
METHOD_NAME=example

# Human-readable description (shown in method listings)
DESCRIPTION=Template method for GraFlag integration (copy this to create new methods)

# Link to original source code or paper
SOURCE_CODE=https://github.com/your-org/your-method

# The commit to build from, if your Dockerfile clones SOURCE_CODE. Required
# then, and it has to be the full 40-character sha: a branch moves and a tag
# can be moved, so neither names one commit a year from now. graflag forwards
# SOURCE_CODE and SOURCE_REF to `docker build` as --build-arg.
# SOURCE_REF=0000000000000000000000000000000000000000

# Where the published numbers come from. Two values:
#
#   upstream          the image fetches the authors' implementation and runs
#                     it -- a `git clone` of SOURCE_CODE, or a pinned install
#                     of their package. Requires SOURCE_REF.
#   reimplementation  nothing upstream is fetched: train_graflag.py implements
#                     the method from the paper, so the results are this code's
#                     and not the authors'. SOURCE_CODE is then a citation, not
#                     what ran, and README.md has to say where the two differ.
#
# This template is a reimplementation because it computes a toy score. Say
# which one yours is; `graflag list methods` prints it next to the name, and a
# reader comparing your AUC to the paper's deserves to know which they are
# looking at.
INTEGRATION=reimplementation

# ------------------------------------------------------------------------------
# OPTIONAL: Dataset Compatibility
# ------------------------------------------------------------------------------
# Comma-separated list of compatible datasets, matched with fnmatch so a
# wildcard works anywhere in the pattern. It is ENFORCED: graflag_runner checks
# the dataset against these patterns when the container starts and refuses to
# run the method on a dataset that matches none of them. `graflag list methods`
# shows the list too.
# Leave empty or omit to say "no restriction".
# Examples:
#   SUPPORTED_DATASETS=uci,btc_alpha,btc_otc    # Specific datasets
#   SUPPORTED_DATASETS=generaldyg_*              # Wildcard pattern
#   SUPPORTED_DATASETS=*_snapshot                # All snapshot datasets
SUPPORTED_DATASETS=

# ------------------------------------------------------------------------------
# REQUIRED: Execution Command
# ------------------------------------------------------------------------------

# Command to run your method (executed inside the Docker container)
# The graflag_runner will append --pass-env-args parameters to this command
COMMAND=python3 train_graflag.py

# ------------------------------------------------------------------------------
# OPTIONAL: Method Parameters (prefix with underscore)
# ------------------------------------------------------------------------------
# These reach the container as environment variables. train_graflag.py turns
# them back into keyword arguments with graflag_runner.params(), which strips
# the underscore, lowercases the name and coerces the value to the type your
# constructor declares -- so _LEARNING_RATE=0.001 arrives as
# learning_rate=0.001 (a float), and a key no constructor accepts is dropped
# rather than passed on as a surprise.
# Users override one with: graflag run -m example -d DATASET --params LEARNING_RATE=0.01
# (no underscore on the command line; GraFlag re-adds it).
#
# If your Dockerfile's CMD has --pass-env-args, they are ALSO appended to
# COMMAND as CLI flags: _BATCH_SIZE=128 -> --batch_size 128 (lowercased).

# Learning rate for optimization
_LEARNING_RATE=0.001

# Number of training epochs
_EPOCHS=100

# Batch size for training
_BATCH_SIZE=32

# Hidden layer dimensions (can be any type, passed as string)
_HIDDEN_DIM=64

# Embedding dimension for node/edge representations
_EMBEDDING_DIM=32

# Random seed for reproducibility
_SEED=42

# ------------------------------------------------------------------------------
# NOTES:
# ------------------------------------------------------------------------------
# - Environment variables DATA and EXP are automatically set by GraFlag:
#   - DATA: Path to the dataset directory (e.g., /shared/datasets/your_dataset)
#   - EXP: Path to the experiment output directory
#
# - Your train_graflag.py must:
#   1. Read parameters with graflag_runner.params()
#   2. Load the dataset with graflag_runner.load_dataset()
#   3. Save results using ResultWriter, which writes to EXP
#
# - Reserved environment variables (set by GraFlag, never define them here --
#   a parameter colliding with one is silently dropped):
#   - DATA, EXP, METHOD_NAME, COMMAND, MONITOR_INTERVAL
# ==============================================================================
