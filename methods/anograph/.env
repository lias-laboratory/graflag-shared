METHOD_NAME=anograph
DESCRIPTION=AnoGraph: Sketch-Based Anomaly Detection in Streaming Graphs (KDD 2023)
SOURCE_CODE=https://github.com/Stream-AD/AnoGraph
# The commit the image is built from. The Dockerfile clones SOURCE_CODE and
# checks this out; graflag forwards both as --build-arg (BUILD_ARG_KEYS in
# docker_ops.py), so neither is repeated in the Dockerfile. Bumping it is a
# deliberate edit, which is the point: an unpinned clone made a rebuild months
# later a different experiment wearing the same method name.
SOURCE_REF=6e8bcd85a39ac49de01ea58d4d15690add8f69c8
# Where the published numbers come from. `upstream` means the image fetches
# the authors' implementation and runs it.
INTEGRATION=upstream

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=anograph_*

COMMAND=python3 train_graflag.py

# Algorithm selection: anograph, anographk, anoedgeg, anoedgel.
# The two anograph* algorithms score time windows (GRAPH_ANOMALY_SCORES) and
# the two anoedge* ones score edges (EDGE_STREAM_ANOMALY_SCORES), so this key
# decides what a result row is.
_ALGORITHM=anograph

# Sketch parameters. Upstream's demo.sh passes `2 32` on every one of its four
# datasets, and those are the numbers its published results are measured at.
#
# _NUM_BUCKETS was 1024 here, which appears nowhere upstream and is not merely
# off-spec: the two anograph* algorithms score a window by greedily peeling the
# sketch matrix, 2*buckets rounds of O(buckets^2) work per sketch row per graph
# (anograph.cpp:118-150). At 32 that is about 10^9 operations for ISCX's 2751
# windows -- seconds. At 1024 it is roughly 3.5*10^13, which does not finish.
# A run at 1024 was left going for thirteen minutes without scoring one window.
#
# This went unnoticed because the binary never used to reach that code: it was
# being handed its input at a path it does not read, and its readers answer a
# missing file with exit(0), so every run ended instantly and successfully
# having done nothing. Restoring the input exposed the parameter.
# Number of rows in the sketch (upstream: 2)
_NUM_ROWS=2
# Number of columns (buckets) in the sketch (upstream: 32)
_NUM_BUCKETS=32

# _TIME_WINDOW and _EDGE_THRESHOLD are ISCX's settings, as upstream's demo.sh
# spells them. DARPA uses 30 and 50 there:
#
#   graflag run -m anograph -d anograph_darpa --params TIME_WINDOW=30 EDGE_THRESHOLD=50
#
# They matter to more than the sketch: the graph algorithms' ground truth is
# regenerated per run by upstream's process_data.py, which marks a window
# anomalous once it holds _EDGE_THRESHOLD anomalous edges. Changing either
# changes the labels, not just the scores.

# Time window for aggregation. Default: 60
_TIME_WINDOW=60

# Edge threshold for anomaly labeling. Default: 100
_EDGE_THRESHOLD=100

# AnoGraph-K specific: number of elements for greedy search. Default: 5
_K=5

# AnoEdge threshold for anomaly score. Default: 0.9
_THRESHOLD=0.9

# Random seed. Default: 42
_SEED=42
