METHOD_NAME=gady
DESCRIPTION=Unsupervised Anomaly Detection on Dynamic Graphs (WSDM 2024)
SOURCE_CODE=https://github.com/mufeng-74/GADY
# The commit the image is built from. The Dockerfile clones SOURCE_CODE and
# checks this out; graflag forwards both as --build-arg (BUILD_ARG_KEYS in
# docker_ops.py), so neither is repeated in the Dockerfile. Bumping it is a
# deliberate edit, which is the point: an unpinned clone made a rebuild months
# later a different experiment wearing the same method name.
SOURCE_REF=1e8e4503e238f0a6c093c3aba946085aa3959410
# Where the published numbers come from. `upstream` means the image fetches
# the authors' implementation and runs it.
INTEGRATION=upstream

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=gady_*

COMMAND=python3 train_graflag.py

# Booleans are spelled out: true or false. This file used to rely on an empty
# value meaning true, which worked only through --pass-env-args (the runner
# turned `_USE_MEMORY=` into a bare `--use_memory` flag). train_graflag.py now
# reads its parameters with graflag_runner.params(), where an empty string is
# false -- so an empty value here would have quietly turned memory off.

# Data Parameters
_ANOMALY_PER=0.1
_TRAIN_PER=0.7
_BS=200

# Model Architecture
_N_LAYER=2
_N_DEGREE=10
_MEMORY_DIM=172
_MESSAGE_DIM=100
_NODE_DIM=100
_TIME_DIM=1

# Memory Settings
_USE_MEMORY=true
_MESSAGE_FUNCTION=identity
_MEMORY_UPDATER=gru
_AGGREGATOR=last
# _MEMORY_UPDATE_AT_END=true

# Positional Features
_R_DIM=4
_BETA=0.00001

# Training Hyperparameters
_N_EPOCH=50
_N_RUNS=1
_LR=0.0001
_PATIENCE=5
_SEED=142
_GPU=0

# GAN Loss Parameters
_ALPHA=0.1
_GAMMA=0.1

# Accepted and recorded, but not read by this integration -- see README.md
# ("Parameters that do nothing"). Changing one warns and changes no result.
_LR_G=0.000001
_LR_D=0.000001
_BETAA=10

# Mode
_MODE=0

# Other Settings
# _PREFIX=my_run
# Boolean flags
# _UNIFORM=true
# _RANDOMIZE_FEATURES=true
# _USE_DESTINATION_EMBEDDING_IN_MESSAGE=true
# _USE_SOURCE_EMBEDDING_IN_MESSAGE=true
# _DIFFERENT_NEW_NODES=true
