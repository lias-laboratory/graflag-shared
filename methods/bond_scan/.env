METHOD_NAME=bond_scan
DESCRIPTION=Structural Clustering Algorithm for Networks
SOURCE_CODE=https://docs.pygod.org/en/latest/generated/pygod.detector.SCAN.html#pygod.detector.SCAN
# Where the published numbers come from. `upstream` means the image fetches
# the authors' implementation and runs it.
INTEGRATION=upstream

# The image this method runs in. Seventeen bond methods share one build:
# their Dockerfiles were byte-identical, and the only thing that forced
# seventeen copies of the same ~9 GB image was the image name being derived
# from the method name. They stay distinct at run time -- graflag sets
# METHOD_NAME per service and graflag_bond.train selects the PyGOD detector
# from it -- so nothing about what runs changes.
#
# The Dockerfile then lives at images/bond_base/Dockerfile, not in this
# directory. Rebuilding it with --build rebuilds it for all seventeen.
IMAGE=bond_base

# Supported datasets (comma-separated, wildcards allowed with *)
SUPPORTED_DATASETS=bond_*

COMMAND=python3 -m graflag_bond.train

# Neighborhood threshold. Default:.5.
_EPS=.5
# Minimal size of clusters. Default:2.
_MU=2
# Valid in (0., 0.5). The proportion of outliers in the data set. Used when fitting to define the threshold on the decision function. Default:0.1.
_CONTAMINATION=0.1
# Verbosity mode. Range in [0, 3]. Larger value for printing out more log information. Default:0.
_VERBOSE=0