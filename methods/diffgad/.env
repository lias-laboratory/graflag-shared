# DiffGAD -- A Diffusion-based Unsupervised Graph Anomaly Detector (ICLR 2025)

METHOD_NAME=diffgad
DESCRIPTION=Diffusion-based unsupervised graph anomaly detector: distils discriminative content in a latent diffusion space (ICLR 2025)
SOURCE_CODE=https://github.com/fortunato-all/LJH_DiffGAD
SOURCE_REF=197d60fe341f3a2080b242f04d4f81025e5f96b6
INTEGRATION=upstream

# Upstream ships one config per dataset under configs/, and these five are the
# ones it ships: books, disney, enron, reddit, weibo. They are exactly the
# BOND graphs GraFlag already stores, under the bond_ prefix.
SUPPORTED_DATASETS=bond_books,bond_disney,bond_enron,bond_reddit,bond_weibo

COMMAND=python3 train_graflag.py

# Only the knobs the authors' per-dataset config does NOT own are defaulted
# here. ae_lr, ae_dropout, ae_alpha, proto_alpha, weight and hid_dim come from
# upstream's configs/<dataset>.yaml, which differs materially per dataset --
# declaring them here would replace a tuned value with a generic one on every
# run. They remain overridable: `--params AE_ALPHA=0.5` still wins, applied on
# top of the loaded config.
_AE_EPOCHS=300
_DIFF_EPOCHS=800
_LR=0.004
_SAMPLE_STEPS=50
_PATIENCE=100
# GPU index. DiffGAD calls .cuda() unconditionally in its own code, so -1
# raises rather than silently running somewhere it cannot.
_GPU=0
_SEED=42
