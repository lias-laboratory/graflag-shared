# F-FADE -- Frequency Factorization for Anomaly Detection in Edge Streams
# WSDM 2021 (Stanford SNAP). Unsupervised, online.

METHOD_NAME=f_fade
DESCRIPTION=F-FADE: frequency-factorization of the time-evolving interaction-frequency distribution between node pairs, scoring each edge by its likelihood (WSDM 2021)
SOURCE_CODE=https://github.com/snap-stanford/F-FADE
SOURCE_REF=917a452fc1fa8bee5fb9cedbbc3d789b4d50ef7f
INTEGRATION=upstream

# Edge streams with per-edge labels. Same two datasets MIDAS runs on; F-FADE's
# own paper evaluates on DARPA, which anograph_darpa is a byte-identical copy of.
SUPPORTED_DATASETS=anograph_darpa,anograph_iscx

COMMAND=python3 train_graflag.py

# Upstream's defaults from arguments.py, which are also the values its run.sh
# uses for DARPA.
_EMBEDDING_SIZE=200
_BATCH_SIZE=32
# Number of edges used to set up the model before scoring begins. Nothing
# before t_setup gets a score, which is why the published scores cover a
# suffix of the stream rather than all of it -- see README.md.
_T_SETUP=8000
# Window between model updates.
_W_UPD=720
# Decay on the frequency estimate.
_ALPHA=0.999
# Time threshold.
_T_TH=120
# Memory size.
_M=100
_EPOCHS=5
_ONLINE_TRAIN_STEPS=10
# CPU. The image installs the CPU torch wheel deliberately -- F-FADE trains a
# small embedding online rather than a GPU model, and its own run.sh sizes the
# work for a CPU. Declaring a GPU index against a CPU-only image would promise
# a device the container cannot see.
_GPU=-1
_SEED=42
